    "explanation": "按商品明细GMV汇总并排序品类。",
    "sql": "SELECT\nCOALESCE(product_category, 'unknown_category') AS product_category,\nROUND(SUM(price), 2) AS gmv\nFROM analytics.order_items\nWHERE is_effective_order AND order_purchase_timestamp >= TIMESTAMP '2018-01-01' AND order_purchase_timestamp < TIMESTAMP '2018-09-01'\nGROUP BY 1\nORDER BY gmv DESC, product_category\nLIMIT 5",
